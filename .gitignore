# Git Ignore for Exchange Control Desk
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env
.venv
env/
venv/
ENV/

# Database files & local run artifacts
*.duckdb
*.duckdb.wal
data/processed/*.duckdb
data/processed/*.wal
logs/*.log
outputs/test_mkt/

# Large generated data (Keep samples and schemas for clean repo size)
# Full datasets can be reproduced anytime via `python -m scripts.run_pipeline`
data/synthetic/transactions.parquet
data/synthetic/ground_truth_anomalies.parquet
data/processed/market_ticks.parquet
powerbi/exports/fact_transactions.csv
powerbi/exports/fact_transactions.parquet
powerbi/exports/fact_anomalies.csv
powerbi/exports/fact_incidents.csv
outputs/incidents/investigation_queue.csv
outputs/incidents/investigation_queue.parquet

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# IDE Files
.vscode/
.idea/
*.swp
*.swo

# Temporary test outputs
.pytest_cache/
.coverage
htmlcov/
