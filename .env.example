# Environment Configuration Template
# Copy to .env and configure local credentials. DO NOT commit .env to version control.

# Database
DB_ENGINE=duckdb
DB_HOST=localhost
DB_PORT=5432
DB_NAME=exchange_control_desk
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# API Keys (Optional - Public endpoints used by default)
COINGECKO_API_KEY=
COINDCX_API_KEY=

# Pipeline Settings
PROJECT_ENV=development
LOG_LEVEL=INFO
RANDOM_SEED=42
